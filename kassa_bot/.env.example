# =====================================================================
#  Kassa — ENV sozlamalari. Nusxa oling:  cp .env.example .env
#  .env faylni hech qachon gitga qo‘shmang va hech kimga yubormang.
# =====================================================================

# --- Telegram ---------------------------------------------------------
# @BotFather bergan token. FAQAT .env ichiga yozing (chatga yubormang).
BOT_TOKEN=
# Bot username, @ belgisisiz (referal havolalar uchun). Bo‘sh qolsa avtomatik aniqlanadi.
BOT_USERNAME=YANGI_BOT_USERNAME
# polling (lokal/oddiy) yoki webhook (production, HTTPS kerak)
BOT_MODE=polling
# Webhook rejimida Telegram yuboradigan maxfiy sarlavha (X-Telegram-Bot-Api-Secret-Token).
# Yaratish: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# Adminlar: telegram_id:rol, vergul bilan. Rollar: superadmin, admin, operator, auditor.
# O‘z Telegram ID ingizni @userinfobot orqali bilib oling va pastdagi namunani almashtiring.
ADMIN_IDS=123456789:superadmin

# --- Infra ------------------------------------------------------------
# Docker Compose bu ikkalasini avtomatik o‘rnatadi; lokal ishga tushirishda kerak.
DATABASE_URL=postgresql+asyncpg://kassa:kassa@localhost:5432/kassa
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=kassa
# API ning tashqi manzili (sandbox sahifalari va webhook URL uchun). Productionda HTTPS domen.
PUBLIC_BASE_URL=http://localhost:8000
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=false

# --- To‘lov provayderi -------------------------------------------------
# Bu sozlamalar ichki hamyon adapteriga tegishli. MobCash alohida ishlaydi!
# Sandbox adapterida real pul harakatlanmaydi. Rasmiy provayder adapteri qo‘shilganda
# uning kodi shu ro‘yxatga yoziladi (README → "Yangi provayder qo‘shish").
PAYMENT_PROVIDERS=sandbox,manual
# test | production. Rasmiy provayder ulanmagan bo‘lsa production rejimida ilova ishga tushmaydi.
PAYMENT_MODE=test
# Sandbox webhook imzosi uchun maxfiy kalit (HMAC-SHA256). Albatta o‘zgartiring.
SANDBOX_WEBHOOK_SECRET=change-me-sandbox-secret
# Sinov uchun: payoutlarning necha foizi vaqtinchalik xato bersin (0.0–1.0)
SANDBOX_PAYOUT_FAILURE_RATE=0.0
SANDBOX_PAYOUT_DELAY_SECONDS=3

# --- Biznes sozlamalari (standart qiymatlar; keyin /admin → ⚙️ dan o‘zgartiriladi) ----
CURRENCY=UZS
TIMEZONE=Asia/Tashkent
# 👨‍💻 Aloqa: @username yoki https://... havola
SUPPORT_URL=@SUPPORT_USERNAME
# 🌐 Kassa manzili: kanal yoki sayt havolasi
CASHBOX_URL=https://t.me/KANAL_YOKI_SAYT
DEPOSIT_MIN=10000
DEPOSIT_MAX=10000000
WITHDRAW_MIN=20000
WITHDRAW_MAX=5000000
DEPOSIT_FEE_PERCENT=0
WITHDRAW_FEE_PERCENT=1
REFERRAL_PERCENT=2
REFERRAL_WITHDRAW_MIN=5000
MAX_BONUS_PER_DEPOSIT=0
PAYMENT_EXPIRY_MINUTES=15
AUTO_PAYOUT_ENABLED=false
AUTO_PAYOUT_MAX=500000
PAYOUT_MAX_ATTEMPTS=5
CONTACT_REQUIRED=false
SUBSCRIPTION_ENABLED=true
VIP_BONUS_ENABLED=true
REFERRAL_ENABLED=true
# 🏆 VIP bo‘limi foydalanuvchilarga ko‘rinadimi (admin panel → 🎁 Bonus tizimidan o‘zgaradi)
VIP_SECTION_ENABLED=true
# 🌐 Telegram Web App (kassa ilovasi). PUBLIC_BASE_URL https:// bo‘lishi shart.
WEBAPP_ENABLED=true

# --- Mob-Cash kassa API -------------------------------------------------
# true: «➕ Hisob to‘ldirish» / «➖ Pul chiqarish» Mob-Cash orqali ishlaydi (P2P + yechish kodi).
# Haqiqiy kassa ulanganda PAYMENT_MODE=test ham MobCash'ni testga aylantirmaydi.
# Quyidagi API manzillari real tizimniki; hujjatda sandbox manzili berilmagan.
# Keyin /admin → ⚙️ → 🏦 Mob-Cash dan o‘zgartiriladi.
MOBCASH_ENABLED=true
# Mob-Cash bergan kassa ma’lumotlari (hujjatdagi 1000042 — faqat namuna, ishlamaydi)
MOBCASH_CASHBOX_CODE=
MOBCASH_LOGIN=
MOBCASH_PASSWORD=
MOBCASH_AUTH_URL=https://admin.mob-cash.com/api/v2/cashbox
MOBCASH_API_URL=https://admin.mob-cash.com/api/v1/mobile
MOBCASH_TIMEOUT_SECONDS=30
# 🤖 Avto to‘lov: ID lar orasidagi pauza (ms). Kassa limit bersa — oshiring.
AUTO_DEPOSIT_DELAY_MS=300

# --- P2P (karta → karta) noyob summa ------------------------------------
# Userbot kuzatadigan bank botlari (keyin admin paneldan o‘zgaradi)
P2P_SOURCES=CardXabarBot,HUMOcardbot
# Summaga qo‘shiladigan noyob qism: 1..N so‘m (50 000 → 50 001 … 50 999)
P2P_UNIQUE_MAX=999
# Muddati o‘tgan to‘lov shu soat ichida kelsa ham avtomatik qabul qilinadi
# (shu vaqt davomida uning summasi boshqa foydalanuvchiga berilmaydi)
P2P_LATE_GRACE_HOURS=24

# --- Userbot (Telethon) -------------------------------------------------
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Userbot sessiyalarini shifrlash kaliti. Yaratish:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Kalit o‘zgarsa barcha userbotlarni qaytadan qo‘shish kerak bo‘ladi.
USERBOT_SESSION_KEY=

# --- Himoya -------------------------------------------------------------
RATE_LIMIT_PER_SECOND=3
RATE_LIMIT_PER_MINUTE=40
# Kunlik hisobot adminlarga yuboriladigan soat (TIMEZONE bo‘yicha)
REPORT_HOUR=9
